{
  "name": "dsh-agent-team-workflow",
  "version": "1.8.1",
  "private": false,
  "description": "DSH plugin for user-defined node-graph workflows: agent, command, HTTP, human, fan-out/join and subworkflow nodes with permissions, artifacts and a live run panel.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./src/v2/plugin.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "src/v2",
    "lib",
    "examples",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/run.mjs",
    "test:runner": "node --test \"tests/*.test.mjs\"",
    "test:watch": "node --test --watch tests/"
  },
  "main": "./src/v2/plugin.mjs",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workflow",
    "node-graph",
    "agent-teams",
    "subagents"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyingloong/dsh-agent-team-workflow.git"
  },
  "homepage": "https://github.com/lyingloong/dsh-agent-team-workflow#readme",
  "bugs": {
    "url": "https://github.com/lyingloong/dsh-agent-team-workflow/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
