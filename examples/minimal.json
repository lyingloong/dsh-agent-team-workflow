{
  "apiVersion": 2,
  "name": "minimal",
  "description": "One human seed and one agent node. No host permissions are needed.",
  "entry": "seed",
  "nodes": [
    {
      "id": "seed",
      "type": "human",
      "title": "Seed",
      "config": { "outcomes": ["approve", "reject"] }
    },
    {
      "id": "write",
      "type": "agent",
      "title": "Write",
      "role": "writer",
      "inputs": { "request": "$input.request" },
      "config": {
        "prompt": "Turn the request into a concrete first draft."
      }
    }
  ],
  "edges": [
    { "from": "seed", "to": "write", "on": "approve" }
  ]
}
