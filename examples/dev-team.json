{
  "apiVersion": 2,
  "name": "dev-team",
  "description": "Implement, test, review and merge. The command node needs a command permission grant; the review loop goes back to implementation.",
  "entry": "seed",
  "providers": [
    { "id": "default", "adapter": "deepseek", "model": "host-default" }
  ],
  "nodes": [
    {
      "id": "seed",
      "type": "human",
      "title": "Seed",
      "config": { "outcomes": ["approve", "reject"] }
    },
    {
      "id": "implement",
      "type": "agent",
      "title": "Implement",
      "role": "engineer",
      "inputs": { "request": "$input.request" },
      "config": {
        "lane": "default",
        "prompt": "Implement the request in the current repository. Report changed files and any risks."
      }
    },
    {
      "id": "test",
      "type": "command",
      "title": "Test",
      "config": { "command": "pnpm test", "timeoutMs": 300000 }
    },
    {
      "id": "review",
      "type": "agent",
      "title": "Review",
      "role": "reviewer",
      "inputs": {
        "request": "$input.request",
        "implementation": "$nodes.implement.output",
        "tests": "$nodes.test.output"
      },
      "config": {
        "lane": "default",
        "outcomes": ["pass", "needs_revision"],
        "prompt": "Review the implementation against the request. Use outcome pass only when no required change remains."
      }
    },
    {
      "id": "merge",
      "type": "human",
      "title": "Merge",
      "config": { "outcomes": ["approve", "reject"] }
    }
  ],
  "edges": [
    { "from": "seed", "to": "implement", "on": "approve" },
    { "from": "implement", "to": "test", "on": "complete" },
    { "from": "test", "to": "review", "on": "complete" },
    { "from": "review", "to": "merge", "on": "pass" },
    { "from": "review", "to": "implement", "on": "needs_revision" }
  ]
}
