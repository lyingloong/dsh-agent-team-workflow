{
  "apiVersion": 2,
  "name": "fanout-review",
  "description": "Fan one plan out to several workers, join their outputs and review the aggregate. Only agent and human nodes are used.",
  "entry": "seed",
  "nodes": [
    {
      "id": "seed",
      "type": "human",
      "title": "Seed",
      "config": { "outcomes": ["approve", "reject"] }
    },
    {
      "id": "split",
      "type": "fanout",
      "title": "Split",
      "config": {
        "items": "$input.items",
        "target": "work",
        "join": "join"
      }
    },
    {
      "id": "work",
      "type": "agent",
      "title": "Work item",
      "role": "worker",
      "inputs": { "item": "$item", "index": "$index" },
      "config": {
        "prompt": "Complete this item independently. Report the result as JSON."
      }
    },
    {
      "id": "join",
      "type": "join",
      "title": "Join",
      "config": { "mode": "all" }
    },
    {
      "id": "review",
      "type": "agent",
      "title": "Review aggregate",
      "role": "reviewer",
      "inputs": { "branches": "$nodes.join.output" },
      "config": {
        "prompt": "Review all branch results together and report a single summary."
      }
    },
    {
      "id": "publish",
      "type": "human",
      "title": "Publish",
      "config": { "outcomes": ["approve", "reject"] }
    }
  ],
  "edges": [
    { "from": "seed", "to": "split", "on": "approve" },
    { "from": "join", "to": "review", "on": "complete" },
    { "from": "review", "to": "publish", "on": "complete" }
  ]
}
