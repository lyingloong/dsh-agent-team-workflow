{
  "apiVersion": 1,
  "name": "product-flow",
  "description": "多节点产品工作流：需求 → 调研 → 写作 → 审查 → 发布",
  "roles": [
    { "id": "planner", "instances": 1, "providers": ["lane-a", "lane-b"] },
    { "id": "researcher", "instances": 1, "providers": ["lane-a", "lane-b"] },
    { "id": "writer", "instances": 1, "providers": ["lane-a", "lane-b"] },
    { "id": "reviewer", "instances": 1, "providers": ["lane-a", "lane-b"] },
    { "id": "releaser", "instances": 1, "providers": ["lane-a", "lane-b"] }
  ],
  "providers": [
    { "id": "lane-a", "model": "host-default", "concurrency": 2, "backoffMinutes": [10, 30] },
    { "id": "lane-b", "model": "host-default", "concurrency": 2, "backoffMinutes": [10, 30] }
  ],
  "stages": [
    { "id": "intake", "title": "需求", "role": "planner", "on": { "complete": "research" } },
    { "id": "research", "title": "调研", "role": "researcher", "on": { "complete": "draft" } },
    { "id": "draft", "title": "写作", "role": "writer", "on": { "complete": "review" } },
    {
      "id": "review",
      "title": "审查",
      "role": "reviewer",
      "options": ["pass", "needs_revision"],
      "on": { "pass": "ready", "needs_revision": "draft" }
    },
    { "id": "ready", "title": "待发布", "role": "releaser" }
  ],
  "gates": [
    { "id": "publish", "after": "review", "outcome": "pass", "kind": "manual", "required": true }
  ],
  "policies": {
    "concurrency": { "global": 6 },
    "retry": { "maxAttempts": 3, "backoffSeconds": [10, 30] },
    "fallback": { "sameRole": true }
  }
}
