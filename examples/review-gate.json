{
  "apiVersion": 1,
  "name": "review-gate",
  "description": "Specify, implement, review, then wait for a human decision before finishing.",
  "roles": [
    { "id": "analyst", "instances": 1, "providers": ["lane-a"] },
    { "id": "engineer", "instances": 1, "providers": ["lane-a"] },
    { "id": "reviewer", "instances": 1, "providers": ["lane-a"] }
  ],
  "providers": [
    { "id": "lane-a", "model": "deepseek-flash" }
  ],
  "stages": [
    { "id": "specify", "role": "analyst", "on": { "complete": "implement" } },
    { "id": "implement", "role": "engineer", "on": { "complete": "review" } },
    {
      "id": "review",
      "role": "reviewer",
      "options": ["pass", "needs_revision"],
      "on": { "pass": "approved", "needs_revision": "implement" }
    },
    { "id": "approved", "role": "reviewer" }
  ],
  "gates": [
    {
      "id": "merge",
      "after": "review",
      "outcome": "pass",
      "kind": "manual"
    }
  ],
  "policies": {
    "retry": { "maxAttempts": 2, "backoffSeconds": [30] }
  }
}
